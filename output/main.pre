}

const char* c_pConectSuccess = "CONNECT-S-";

static bit s_bRecvBleCmdStart;
static bit s_bRecvAtCmdStart;
static unsigned char s_cUart1RecvPos;
void vUart1Recv(void)
{
if(RC1IF)
{
unsigned char temp = RCREG1;

if(s_bRecvBleCmdStart)
{
g_cUart1RecvBuff[s_cUart1RecvPos++] = temp;
if(3 <= s_cUart1RecvPos)
{
s_cUart1RecvPos = 0;
s_bRecvBleCmdStart = 0;

unsigned char sum = g_cUart1RecvBuff[0]+g_cUart1RecvBuff[1];
sum = ~sum;
if(g_cUart1RecvBuff[2] == sum)
{

g_bBtConectSuccessFlg = 1;
g_cBtConectSuccessTime = 0;

if((g_cUart1RecvBuff[0] & 0x80)==0x00)
{

g_xIhProcParam.CurTempr = g_cUart1RecvBuff[1];

# 512
}
}
}
}
else if(s_bRecvAtCmdStart)
{
g_cUart1RecvBuff[s_cUart1RecvPos++] = temp;


if(temp == '\n')
{
if(s_cUart1RecvPos<=14)
{
char *p = c_pConectSuccess;

if((0) != strstr(g_cUart1RecvBuff, p))
{

g_bBtConectSuccessFlg = 1;
g_cBtConectSuccessTime = 0;
}
}
s_bRecvAtCmdStart = 0;
s_cUart1RecvPos = 0;
}

if(16 <= s_cUart1RecvPos)
{
s_bRecvAtCmdStart = 0;
s_cUart1RecvPos = 0;
}
}
else
{
if(temp == 0x55)
{
s_bRecvBleCmdStart = 1;
s_cUart1RecvPos = 0;
memset(g_cUart1RecvBuff, 0, 16);
}
else if(temp == '+')
{
s_bRecvAtCmdStart = 1;
s_cUart1RecvPos = 0;
memset(g_cUart1RecvBuff, 0, 16);
}
}
if(OERR1)
{
CREN1 = 0;
CREN1 = 1;
}
}
}


