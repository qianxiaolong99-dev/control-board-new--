}


void main(void)
{
vInitIc();
Delay_nms(200);
Init_ram();


vInitDecoding();

vReadSysCfg();

while (1)
{
OSCCON = 0x71;
vIntimeCopyData();
RecvDataAnalysis();
asm("clrwdt");

vUart1Send();
asm("clrwdt");

# 613
if (32 <= g_cT4msCounter)
{
g_cT4msCounter = 0;
g_xLoopTime.t20ms++;


Sys_set();

__CMS_CheckTouchKey();

Kscan();

Knob_Scan();
}

if (5 <= g_xLoopTime.t20ms)
{
g_xLoopTime.t20ms = 0;


vStartKeyProc();
vSettingKeyProc();


vOkKeyProc();

asm("clrwdt");

vTimeLoop();

asm("clrwdt");

vSystemStatus();
vTxDataReady();

vLedBreath();
}


UpdateTftDisplay();
}
}

# 666
bit Memory_Write(unsigned char Addr, unsigned char Value)
{
static volatile bit B_GIE_On;
static volatile unsigned char i = 0;

B_GIE_On = 0;
if (GIE)
B_GIE_On = 1;


EEADR = Addr;
EEDAT = Value;
EECON1 = 0;
EEPGD = 0;
EECON1 | = 0x30;
asm("clrwdt");


WREN = 1;
GIE = 0;

while (GIE)
{
GIE = 0;
if (0 == --i)
return 0;
}
asm("clrwdt");

EECON2 = 0x55;
EECON2 = 0xaa;
WR = 1;
asm("nop");
asm("nop");
asm("clrwdt");
WREN = 0;
if (B_GIE_On)
GIE = 1;

if (WRERR) return 0;
else return 1;
}

# 717
unsigned char Memory_Read(unsigned char Addr)
{
EEADR = Addr;
EEPGD = 0;
RD = 1;
asm("nop");
asm("nop");

return EEDAT;
}



