}


void Kscan()
{
static unsigned int KeyOldFlag = 0;
unsigned int KeyOnOutput = 0;

if (0 < g_cDisableKeyTime)
g_cDisableKeyTime--;

KeyOnOutput = (unsigned int)((_CMS_KeyFlag[1] << 8) | _CMS_KeyFlag[0]);

if (KeyOnOutput)
{
if (KeyOnOutput == KeyOldFlag) return;

KeyOldFlag = KeyOnOutput;

if (0 < g_cDisableKeyTime) return;

switch (KeyOnOutput)
{
case 0x0002:
g_bStartKeyPressed = 1;
g_cDisableKeyTime = 10;
break;
case 0x0001:
g_bSetKeyPressed = 1;
g_cDisableKeyTime = 10;
break;

# 147
default:
break;
}
}
else
{
KeyOldFlag = 0;

g_bKeyShortPressed = 0;

g_bStartKeyPressed = 0;
g_bSetKeyPressed = 0;




}
}

void vStartKeyProc()
{
if(g_bStartKeyPressed)
{
g_bStartKeyPressed = 0;
vSetBuzzer(0);
bQueueEn(StartKey);
}
}

void vSettingKeyProc()
{
if(g_bSetKeyPressed)
{
g_bSetKeyPressed = 0;
vSetBuzzer(0);
bQueueEn(SetKey);
}
}

void vOkKeyProc()
{

# 209
if(RC5)
{
if(RC5)
{
g_cOkKeyCounter = 0;
g_bOkKeyPressed = 0;
g_bOkKeyLPressed = 0;
}
}
else
{
g_cOkKeyCounter++;
if(50 <= g_cOkKeyCounter)
{
if(!g_bOkKeyLPressed)
{
g_bOkKeyLPressed = 1;

bQueueEn(OkLKey);
}
}
else if(3 <= g_cOkKeyCounter)
{
if(!g_bOkKeyPressed)
{
g_bOkKeyPressed = 1;
bQueueEn(OkKey);
}
}
}
}

# 303
void vTimeLoop(void)
{
g_xLoopTime.t100ms++;
if (g_xLoopTime.t100ms < 5) return;
g_xLoopTime.t100ms = 0;




g_xLoopTime.t500ms++;
if (5 <= g_xLoopTime.t500ms)
{
g_xLoopTime.t500ms = 0;


bQueueEn(Tim05STrig);


if(g_eSysStatus == SETTING2)
{
g_cSt2NoOprTimer++;
if(10 <= g_cSt2NoOprTimer)
{
g_cSt2NoOprTimer = 0;
bQueueEn(Tim5SNoOpr);
}
}
}

g_xLoopTime.t1S++;
if (10 <= g_xLoopTime.t1S)
{
g_xLoopTime.t1S = 0;


vBtConnectProc();

g_xLoopTime.t5S++;
if (5 <= g_xLoopTime.t5S)
{
g_xLoopTime.t5S = 0;


if(g_eSysStatus == WAITING)
{
g_cSwch2SleepTime++;
if(36 <= g_cSwch2SleepTime)
{
g_cSwch2SleepTime = 0;
bQueueEn(Tim3MinNoOpr);
}
}
else if(g_eSysStatus == HEATING)
{

if(g_bKettleLift)
{
g_cLiftKettleTime++;
if(60 <= g_cLiftKettleTime)
{
g_cLiftKettleTime = 0;

bQueueEn(StartKey);
}
}
else
g_cLiftKettleTime = 0;
}
else if(g_eSysStatus == SETTING1)
{
g_cSt1NoOprTimer++;
if(12 <= g_cSt1NoOprTimer)
{
g_cSt1NoOprTimer = 0;
bQueueEn(Tim1MNoOpr);
}
}

g_xLoopTime.t1Min++;
if (12 <= g_xLoopTime.t1Min)
{
g_xLoopTime.t1Min = 0;


if(g_eSysStatus== HEATING)
{
if(g_bKeepWarmFlag)
{
g_cKeepWarmTime++;
if(g_xSysSetting.KWTime < g_cKeepWarmTime)
{
bQueueEn(StartKey);
}
}
}
}
}
}
}


