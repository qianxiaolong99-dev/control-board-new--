   644                           	psect	clrtext
   645  0800                     clear_ram0:	
   646                           ;	Called with FSR containing the base address, and
   647                           ;	W with the last address+1
   648                           
   649  0800  0064               	clrwdt	;clear the watchdog before getting into this loop
   650  0801                     clrloop0:	
   651  0801  0180               	clrf	0	;clear RAM location pointed to by FSR
   652  0802  0A84               	incf	4,f	;increment pointer
   653  0803  0604               	xorwf	4,w	;XOR with final address
   654  0804  1903               	btfsc	3,2	;have we reached the end yet?
   655  0805  3400               	retlw	0	;all done for this memory range, return
   656  0806  0604               	xorwf	4,w	;XOR again to restore value
   657  0807  2801               	goto	clrloop0	;do the next byte
