1:                // byte unsigned division
2:                
3:                unsigned char
4:                __lbdiv(unsigned char dividend, unsigned char divisor)
  0F56    00D4    LD	0x54,A
  0F57    01D6    CLR	0x56
  0F58    0853    LD	A,0x53
  0F59    1903    SZB	0x3,2
  0F5A    2F6F    JP	0x76F
  0F5B    01D5    CLR	0x55
  0F5C    0AD5    INCR	0x55
  0F5D    1BD3    SZB	0x53,7
  0F5E    2F62    JP	0x762
  0F5F    1003    CLRB	0x3,0
  0F60    0DD3    RLCR	0x53
  0F61    2F5C    JP	0x75C
  0F62    1003    CLRB	0x3,0
  0F63    0DD6    RLCR	0x56
  0F64    0853    LD	A,0x53
  0F65    0254    SUBA	0x54
  0F66    1C03    SNZB	0x3,0
  0F67    2F6C    JP	0x76C
  0F68    0853    LD	A,0x53
  0F69    02D4    SUBR	0x54
  0F6A    1456    SETB	0x56,0
  0F6B    1003    CLRB	0x3,0
  0F6C    0CD3    RRCR	0x53
