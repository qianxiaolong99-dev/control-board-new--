1:                // byte unsigned modulus
2:                
3:                unsigned char
4:                __lbmod(unsigned char dividend, unsigned char divisor)
  0F3A    00D0    LD	0x50,A
  0F3B    3008    LDIA	0x8
  0F3C    00D1    LD	0x51,A
  0F3D    01D2    CLR	0x52
  0F3E    0850    LD	A,0x50
  0F3F    00CF    LD	0x4F,A
  0F40    3007    LDIA	0x7
  0F41    1003    CLRB	0x3,0
  0F42    0CCF    RRCR	0x4F
  0F43    3EFF    ADDIA	0xFF
  0F44    1003    CLRB	0x3,0
  0F45    1D03    SNZB	0x3,2
  0F46    2F42    JP	0x742
  0F47    0D52    RLCA	0x52
  0F48    044F    ORA	0x4F
  0F49    00D2    LD	0x52,A
  0F4A    1003    CLRB	0x3,0
  0F4B    0DD0    RLCR	0x50
  0F4C    084E    LD	A,0x4E
  0F4D    0252    SUBA	0x52
  0F4E    1C03    SNZB	0x3,0
  0F4F    2F52    JP	0x752
  0F50    084E    LD	A,0x4E
  0F51    02D2    SUBR	0x52
  0F52    0BD1    SZDECR	0x51
  0F53    2F3E    JP	0x73E
  0F54    0852    LD	A,0x52
  0F55    0008    RET
5:                {
6:                	unsigned char	rem;
7:                	unsigned char	counter;
8:                
9:                	counter = 8;
10:               	rem = 0;
11:               	do {
12:               		rem = (rem << 1) | (dividend >> 7);
13:               		dividend <<= 1;
14:               		if(divisor <= rem)
15:               			rem -= divisor;
16:               	} while(--counter != 0);
17:               	return rem;
18:               }
