656:              /***********************************************
657:              函数名称：Memory_Write
658:              函数功能：写数据/程序寄存器
659:              入口参数：Addr - 写入地址
660:              		  Value - 写入数值
661:              出口参数：返回值 0 - 写操作错误 1 - 写完毕
662:              备注：
663:              1.写闪存程序空间，执行完写操作指令后，处理器会使内部操作暂停，时间非固定精准。所以写时效性较高的程序时，需要特别注意处理好时间。
664:              2.写程序EE过程中需要暂时关闭中断，以保证写EE时序中的写55H和写AAH能够连续进行，否则将有可能写错，并且写EE的可靠工作电压范围为3V以上。
665:              ************************************************/
666:              bit Memory_Write(unsigned char Addr, unsigned char Value)
  1FD3    00CF    LD	0x4F,A
667:              {
668:              	static volatile bit B_GIE_On;
669:              	static volatile unsigned char i = 0;
670:              
671:              	B_GIE_On = 0;							//记录进来前是否已经开启中断
  1FD4    1221    CLRB	0x21,4
672:              	if (GIE)
  1FD5    1B8B    SZB	0xB,7
673:              		B_GIE_On = 1;
  1FD6    1621    SETB	0x21,4
674:              
675:              	//将要写入的地址放入EEADDR寄存器
676:              	EEADR = Addr;
  1FD7    1703    SETB	0x3,6
  1FD8    008D    LD	0xD,A
677:              	EEDAT = Value;						//将要写入的数据给EEPROM的数据寄存器
  1FD9    1303    CLRB	0x3,6
  1FDA    084E    LD	A,0x4E
  1FDB    1703    SETB	0x3,6
  1FDC    008C    LD	0xC,A
678:              	EECON1 = 0;
  1FDD    019B    CLR	0x1B
679:              	EEPGD = 0;							//访问数据存储器
  1FDE    139B    CLRB	0x1B,7
680:              	EECON1 | = 0x30;					//烧写时间10ms,时间非固定精准,用户可自定义
  1FDF    3030    LDIA	0x30
  1FE0    049B    ORR	0x1B
  1FE1    0064    CLRWDT
681:              	asm("clrwdt");
682:              
683:              
684:              	WREN = 1;								//允许写周期
  1FE2    1283    CLRB	0x3,5
  1FE3    1703    SETB	0x3,6
  1FE4    151B    SETB	0x1B,2
685:              	GIE = 0;								//关闭中断
  1FE5    138B    CLRB	0xB,7
686:              
687:              	while (GIE)
  1FE6    1F8B    SNZB	0xB,7
  1FE7    2FEE    JP	0x7EE
688:              	{
689:              		GIE = 0;							//确保中断已关闭
  1FE8    138B    CLRB	0xB,7
690:              		if (0 == --i)
  1FE9    1683    SETB	0x3,5
  1FEA    1303    CLRB	0x3,6
  1FEB    0BC7    SZDECR	0x47
  1FEC    2FE6    JP	0x7E6
  1FED    0008    RET
  1FEE    0064    CLRWDT
691:              			return 0;
692:              	}
693:              	asm("clrwdt");
694:              
695:              	EECON2 = 0x55;							//给EECON2写入0x55
  1FEF    3055    LDIA	0x55
  1FF0    1283    CLRB	0x3,5
  1FF1    1703    SETB	0x3,6
  1FF2    009C    LD	0x1C,A
696:              	EECON2 = 0xaa;							//给EECON2写入0xaa
  1FF3    30AA    LDIA	0xAA
  1FF4    009C    LD	0x1C,A
697:              	WR = 1;									//启动写周期
  1FF5    149B    SETB	0x1B,1
  1FF6    0000    NOP
  1FF7    0000    NOP
  1FF8    0064    CLRWDT
698:              	asm("nop");
699:              	asm("nop");
700:              	asm("clrwdt");
701:              	WREN = 0;								//禁止写入
  1FF9    1283    CLRB	0x3,5
  1FFA    1703    SETB	0x3,6
  1FFB    111B    CLRB	0x1B,2
702:              	if (B_GIE_On)							//若原来已开启中断的就开启中断	
  1FFC    1303    CLRB	0x3,6
  1FFD    1A21    SZB	0x21,4
703:              		GIE = 1;
  1FFE    178B    SETB	0xB,7
704:              
705:              	if (WRERR)	return 0;				//写操作错误							
706:              	else		return 1;				//写完毕
707:              }
708:              
709:              /***********************************************
710:              函数名称：Memory_Read
711:              函数功能：读数据/程序寄存器
712:              入口参数：Addr - 读取地址
713:              出口参数：返回读取地址相应数值
714:              备注：
715:              1.程序EEPROM最多可读写8位数据，程序存储器最多可读16位数据，操作时请注意两者的差异。
716:              ************************************************/
717:              unsigned char Memory_Read(uchar Addr)
