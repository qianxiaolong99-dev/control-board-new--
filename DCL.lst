  1795    0854    LD	A,0x54
  1796    02D6    SUBR	0x56
  1797    0855    LD	A,0x55
  1798    1C03    SNZB	0x3,0
  1799    03D7    DECR	0x57
  179A    02D7    SUBR	0x57
  179B    1459    SETB	0x59,0
