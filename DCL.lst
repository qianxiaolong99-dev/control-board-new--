  1618    139B    CLRB	0x1B,7
721:              	RD = 1;									//允许读操作
  1619    141B    SETB	0x1B,0
  161A    0000    NOP
  161B    0000    NOP
722:              	asm("nop");
723:              	asm("nop");
724:              
725:              	return EEDAT;
  161C    1283    CLRB	0x3,5
  161D    1703    SETB	0x3,6
  161E    080C    LD	A,0xC
  161F    0008    RET
726:              }
